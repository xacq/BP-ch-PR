# Database (MySQL). When running the app via docker-compose, DATABASE_URL is
# overridden automatically to point at the "db" service instead of localhost.
DATABASE_URL="mysql://beautypalast:change-me@localhost:3308/beautypalast"

# Also read by docker-compose.yml to configure the MySQL container itself.
MYSQL_DATABASE="beautypalast"
MYSQL_USER="beautypalast"
MYSQL_PASSWORD="change-me"
MYSQL_ROOT_PASSWORD="change-me-too"

# Published host ports (avoid clashes with other compose stacks)
MYSQL_PUBLISHED_PORT=3308
APP_PORT=5000
ADMINER_PORT=8080

# Admin CMS access (/admin)
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-a-long-random-string
